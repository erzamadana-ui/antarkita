  "scripts": {
    "start": "expo start",
    "start:mitra": "APP=mitra expo start",
    "start:admin": "APP=admin expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test:audio": "node scripts/test-audio-route.mjs",
    "test:push": "node scripts/test-push-routing.mjs",
    "test": "npm run test:audio && npm run test:push",
    "lint": "expo lint",
    "postinstall": "node scripts/gen-leaflet.mjs",
    "build:web": "node scripts/build-web.mjs",
    "build:web:pelanggan": "APP=pelanggan expo export --platform web --output-dir dist",
    "build:web:mitra": "APP=mitra expo export --platform web --output-dir dist/mitra",
    "build:web:admin": "APP=admin expo export --platform web --output-dir dist/admin",
    "prebuild:pelanggan": "APP=pelanggan expo prebuild --platform android --no-install",
    "prebuild:mitra": "APP=mitra expo prebuild --platform android --no-install"
